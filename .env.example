# ============================================================================
# 自建部署配置示例：复制为 .env（或 .env.local）后按需修改。
# .env* 已被 .gitignore 忽略，不会进入仓库。
# ============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ----------------------------------------------------------------------------
# 中继服务器地址（自建部署的核心配置项，改成你自己的域名即可）
# ----------------------------------------------------------------------------

# 服务端使用：生成「Bridge 一键启动命令 / 一键 bat 脚本」时写入的服务器地址。
# 被 server.ts 读取（进程环境变量优先，其次 .env）。
SERVER_BASE_URL="https://www.lx00924ai.top"

# 前端静态产物使用：网页端默认会自适应当前访问域名（window.location.origin），
# 仅当要把 dist/ 放到 CDN、指向另一台后端时才需要显式指定。
VITE_SERVER_BASE_URL="https://www.lx00924ai.top"

# Vite dev server 的 Host 白名单（逗号分隔），用于追加你自己的域名。
# 默认已放行 www.lx00924ai.top / localhost / 127.0.0.1。
# 例：VITE_ALLOWED_HOSTS="app.example.com,relay.example.com"
VITE_ALLOWED_HOSTS=""

# ----------------------------------------------------------------------------
# 数据保护（对外提供中继服务时建议按需调整）
# ----------------------------------------------------------------------------

# 聊天记录保留天数：超过就自动清理（0 = 永久保存，不清理）。默认 180。
# 合规提示：《个人信息保护法》第 19 条要求保存期限为实现目的所必要的最短时间。
MESSAGE_RETENTION_DAYS="180"

# 图片 / 文件 / 语音保留天数：按文件修改时间清理（0 = 永久保存）。默认 90。
MEDIA_RETENTION_DAYS="90"

# 是否把用户填写的 API Key / ASR Key / Agent Token 落盘：
#   1（默认）= 以 AES-256-GCM 加密后保存，换设备可免输入；
#   0        = 完全不落盘（换设备需重新填写；调用模型用的是客户端随请求带来的 Key，
#              功能不受影响）——安全性最高。
STORE_API_KEYS="1"

# 加密主密钥（base64 编码的 32 字节）。留空则自动生成并保存到 <部署目录>/.secrets/master.key
# ——该文件**位于数据目录之外**，目的是"只拿到数据文件副本也解不出明文"。
# 请务必备份；丢失后已加密的字段需要用户重新填写（不影响其它数据）。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENC_KEY=""

